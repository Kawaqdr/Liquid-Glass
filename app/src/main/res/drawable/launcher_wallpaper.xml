<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#050914"
                android:centerColor="#102A4C"
                android:endColor="#050914" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="50%"
                android:centerY="42%"
                android:startColor="#304F78"
                android:centerColor="#142B4B"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>